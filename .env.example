# `pnpm dev` copies this to .env on first run. This file holds no secrets; .env is git-ignored and never logged.

# Platform database (core tier)
PLATFORM_DB_PORT=54320
DATABASE_URL=postgres://study:study@localhost:54320/study

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Host bridge: the native process that runs task checks in sandboxes.
# The secret is shared by the bridge and the worker. Leave it empty here:
# `pnpm dev` writes a random one into .env on first run.
BRIDGE_PORT=4100
BRIDGE_URL=http://localhost:4100
BRIDGE_SECRET=

# Stripe sandbox keys (module 10 only)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
