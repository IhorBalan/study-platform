{
  "name": "inventory-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:reset": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -c 'drop schema if exists public cascade; create schema public' -f db/schema.sql",
    "demo": "npm run build && node dist/demo.js"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "7.0.2"
  }
}
